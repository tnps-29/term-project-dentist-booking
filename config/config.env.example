# Copy this file to config/config.env and fill in the values.
# config/config.env is git-ignored: never commit real secrets.

NODE_ENV=development
# 5000 is taken by AirPlay Receiver on macOS, so use 5001
PORT=5001

# Local:  mongodb://127.0.0.1:27017/dentist-booking
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/dentist-booking
MONGO_URI=mongodb://127.0.0.1:27017/dentist-booking

# JWT (T07). Generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRE=30d
# Cookie lifetime in days
JWT_COOKIE_EXPIRE=30

# Email / SMTP (T18), used by reset password and reminders.
# Leave SMTP_HOST empty to skip sending: emails are printed to the console.
# Testing inbox: https://mailtrap.io (sandbox SMTP, port 2525)
# Gmail: host smtp.gmail.com, port 465, password = an App Password
SMTP_HOST=
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=
FROM_NAME=Dentist Booking
FROM_EMAIL=noreply@dentist-booking.local
