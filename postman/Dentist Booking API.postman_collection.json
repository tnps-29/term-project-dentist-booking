  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Unique email per run so the Collection Runner can be repeated",
                  "const email = \"user\" + Date.now() + \"@example.com\";",
                  "pm.environment.set(\"userEmail\", email);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test(\"Role is user\", () => pm.expect(json.data.role).to.eql(\"user\"));",
                  "pm.test(\"Password is not returned\", () => pm.expect(json.data).to.not.have.property(\"password\"));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"tel\": \"0812345678\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseURL}}/auth/register",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Creates a user with a unique email each run and stores it in {{userEmail}} for Login (user)."
          },
          "response": []
        },
        {
          "name": "Login (user)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"Response has a token\", () => pm.expect(json.token).to.be.a(\"string\").and.not.empty);",
                  "if (json.token) {",
                  "  pm.environment.set(\"token\", json.token);",
                  "  console.log(\"Saved token for\", json.email, \"(role:\", json.role + \")\");",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseURL}}/auth/login",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Login (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));\nconst json = pm.response.json();\npm.test(\"Response has a token\", () => pm.expect(json.token).to.be.a(\"string\").and.not.empty);\nif (json.token) {\n  pm.environment.set(\"adminToken\", json.token);\n  console.log(\"Saved adminToken for\", json.email, \"(role:\", json.role + \")\");\n}\npm.test(\"Role is admin\", () => pm.expect(pm.response.json().role).to.eql(\"admin\"));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseURL}}/auth/login",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Needs the admin account from the seed script (T17)."
          },
          "response": []
        },
