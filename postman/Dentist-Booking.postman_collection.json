{
  "info": {
    "name": "Dentist Booking API",
    "description": "Term project: Dentist Booking System (group HelloWorld).\n\nSelect the **Dentist Booking - Local** environment. Run **Auth → Register** then **Login (user)**; the login test script saves the JWT to `{{token}}`, and every request inherits `Authorization: Bearer {{token}}` from the collection. Admin requests use `{{adminToken}}` (run **Login (admin)** after the seed data from T17 exists).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "description": "T06–T10 (A)",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Unique email per run so the Collection Runner can be repeated",
                  "const email = \"user\" + Date.now() + \"@example.com\";",
                  "pm.environment.set(\"userEmail\", email);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test(\"Role is user\", () => pm.expect(json.data.role).to.eql(\"user\"));",
                  "pm.test(\"Password is not returned\", () => pm.expect(json.data).to.not.have.property(\"password\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"tel\": \"0812345678\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseURL}}/auth/register",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Creates a user with a unique email each run and stores it in {{userEmail}} for Login (user)."
          },
          "response": []
        },
        {
          "name": "Login (user)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"Response has a token\", () => pm.expect(json.token).to.be.a(\"string\").and.not.empty);",
                  "if (json.token) {",
                  "  pm.environment.set(\"token\", json.token);",
                  "  console.log(\"Saved token for\", json.email, \"(role:\", json.role + \")\");",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseURL}}/auth/login",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Login (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"Response has a token\", () => pm.expect(json.token).to.be.a(\"string\").and.not.empty);",
                  "if (json.token) {",
                  "  pm.environment.set(\"adminToken\", json.token);",
                  "  console.log(\"Saved adminToken for\", json.email, \"(role:\", json.role + \")\");",
                  "}",
                  "pm.test(\"Role is admin\", () => pm.expect(pm.response.json().role).to.eql(\"admin\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseURL}}/auth/login",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Needs the admin account from the seed script (T17)."
          },
          "response": []
        },
        {
          "name": "Get current user (me)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Returns the logged-in user\", () => pm.expect(pm.response.json().data.email).to.eql(pm.environment.get(\"userEmail\")));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseURL}}/auth/me",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "// JWTs are stateless: forget the token on the client side too",
                  "pm.environment.set(\"token\", \"\");",
                  "console.log(\"Cleared token\");"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseURL}}/auth/logout",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get current user after logout (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseURL}}/auth/me",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
